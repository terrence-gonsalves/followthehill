# ============================================================
# FollowTheHill — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to Git.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # Keep secret — server only

# ── Anthropic ────────────────────────────────────────────────
# Found in: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe ───────────────────────────────────────────────────
# Found in: dashboard.stripe.com → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...           # From: stripe listen --forward-to localhost:3000/api/stripe/webhook

# Stripe Product IDs — create these in Stripe Dashboard first
STRIPE_SUBSCRIPTION_PRICE_ID=price_...   # Monthly recurring price for AI tier
STRIPE_SUPPORT_PRODUCT_ID=prod_...       # One-time support payment product

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000  # Change to https://followthehill.ca in production

# ── Cron security ────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Add to Vercel environment variables too
CRON_SECRET=your-random-secret-here
